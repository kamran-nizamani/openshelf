# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# SERVER ONLY - never prefix with NEXT_PUBLIC_, never commit
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Upload limits
MAX_PDF_SIZE_MB=50
MAX_COVER_SIZE_MB=5
UPLOADS_PER_DAY=5

# Malware scanning (optional until configured). Provider: "virustotal" | "none"
MALWARE_SCAN_PROVIDER=none
VIRUSTOTAL_API_KEY=

# Public contact address shown on /contact and /copyright (optional)
NEXT_PUBLIC_CONTACT_EMAIL=
# Comma-separated social profile URLs for the footer (optional)
NEXT_PUBLIC_SOCIAL_LINKS=
